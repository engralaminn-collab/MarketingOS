# ─────────────────────────────────────────────────────────────────────────────
# ALO Labs MarketingOS — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# This file is the canonical reference for every environment variable the
# application and its maintenance scripts MAY read. Copy it to `.env` and fill
# in real values. Variables marked (REQUIRED) MUST be set before the app will
# start in production. Variables marked (OPTIONAL) advertise a capability but
# are not wired into runtime code until the corresponding integration phase
# ships; absent values make the relevant /api/* route report "not configured"
# rather than pretending to be connected.
#
# NEVER commit the real `.env`. The `.gitignore` excludes `.env` (exact match)
# while keeping `.env.example` tracked.
# ─────────────────────────────────────────────────────────────────────────────


# ═════════════════════════════════════════════════════════════════════════════
# REQUIRED — read by the running application. App WILL NOT START without these.
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# SQLite path for local dev (relative or absolute). MySQL/PostgreSQL URL for
# production. The Prisma client (`src/lib/db.ts`) reads this directly.
#
# Dev:     file:./db/custom.db
# Prod:    mysql://USER:PASSWORD@HOST:3306/DATABASE
#          postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL="file:./db/custom.db"

# ─────────────────────────────────────────────────────────────────────────────
# JWT SIGNING SECRET (REQUIRED — min 32 chars)
# ─────────────────────────────────────────────────────────────────────────────
# Signs all session tokens (HS256, 7-day expiry). A weak or default secret
# lets an attacker forge any user's session. In production the app refuses to
# start if this is unset (`src/lib/auth.ts`).
#
# Generate: openssl rand -hex 32
JWT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# VAULT MASTER KEY (REQUIRED in production — AES-256-GCM)
# ─────────────────────────────────────────────────────────────────────────────
# 32 bytes (256 bits) encoded as base64. Used by src/lib/vault.ts to encrypt
# every OAuth access token, refresh token, and manual credential before
# database storage. Without this, /api/v1/integrations/* routes fail closed
# in production. The key is never written to logs or returned by any API.
#
# Rotate the key by:  1. Setting VAULT_MASTER_KEY to the new value
#                     2. Running scripts/rotate-vault-keys.ts to re-encrypt
#                        all rows still encrypted with the previous version.
#
# Generate: openssl rand -base64 32
VAULT_MASTER_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN BOOTSTRAP IDENTITY (REQUIRED — read by prisma/seed.ts)
# ─────────────────────────────────────────────────────────────────────────────
# Email and password of the seeded super-admin user. The seed script refuses
# to run in production if the password is missing or shorter than 8 chars.
# Generate the password with: openssl rand -base64 24
ADMIN_SEED_EMAIL="admin@alolabs.net"
ADMIN_SEED_PASSWORD=""


# ═════════════════════════════════════════════════════════════════════════════
# RUNTIME — read by Next.js standalone server and Node process
# ═════════════════════════════════════════════════════════════════════════════
NODE_ENV="production"
PORT="3055"
HOSTNAME="0.0.0.0"

# NOTE: PORT and HOSTNAME above are read by the Next.js standalone server
# (`node server.js`), not by application code. GIT_COMMIT is injected by the
# Dockerfile; leave it unset everywhere else.

# ─────────────────────────────────────────────────────────────────────────────
# SITE IDENTITY (canonical URLs in metadata, robots.txt and sitemap.xml)
# ─────────────────────────────────────────────────────────────────────────────
# Single source of truth for every absolute URL the app emits. Must match the
# public origin terminated by the reverse proxy (Caddy in front of port 3055);
# a wrong value silently points search engines and Open Graph cards at
# another host.
NEXT_PUBLIC_SITE_URL="https://marketing.alolabs.net"
# Used for provider referrer headers (OpenRouter-compatible endpoints).
NEXT_PUBLIC_APP_URL="https://marketing.alolabs.net"

# ─────────────────────────────────────────────────────────────────────────────
# REALTIME SERVICE (read by marketingos/mini-services/realtime-service)
# ─────────────────────────────────────────────────────────────────────────────
# HMAC secret verifying inbound push messages from the realtime mini-service.
# Generate: openssl rand -hex 32
PUSH_SECRET=""


# ═════════════════════════════════════════════════════════════════════════════
# AI PROVIDERS
# ═════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# PRIMARY AI — Z.AI SDK (used by all /api/ai/* and /api/agents/* routes)
# ─────────────────────────────────────────────────────────────────────────────
# IMPORTANT: the z-ai-web-dev-sdk does NOT read these from env vars. It reads
# a JSON config file at ONE of these paths (first match wins):
#     1. <project-root>/.z-ai-config          ← per-deploy override
#     2. ~/.z-ai-config                        ← user-level config
#     3. /etc/.z-ai-config                      ← system-wide (production)
# The file MUST have this shape:
#     { "baseUrl": "https://api.z.ai/api/v1", "apiKey": "your-key-here" }
# On the Ubuntu production host, /etc/.z-ai-config is owned by root (mode 0644)
# and is the only path the runtime reads. Do NOT commit a project-level
# .z-ai-config to git. Treat the apiKey inside it as a secret — equivalent
# to a database password.

# ─────────────────────────────────────────────────────────────────────────────
# AI FALLBACK CHAIN (additional self-hosted or explicitly configured backends)
# ─────────────────────────────────────────────────────────────────────────────
# Optional explicit fallback order. When blank, configured FREE-tier cloud
# providers are tried in this order after the primary: Groq, Gemini,
# OpenRouter, Cloudflare Workers AI, Mistral. Only providers with keys
# configured are tried. This does not enable paid APIs automatically. Free-tier
# quotas and terms apply.
AI_FALLBACK_CHAIN="groq,gemini,openrouter,cloudflare,mistral"

# Embeddings for RAG. "local" uses Ollama; "gemini" uses GEMINI_API_KEY.
AI_EMBED_PROVIDER="local"
OLLAMA_EMBED_MODEL="bge-m3"
# Local Ollama instance — only set if your local Ollama sits behind an
# authenticated proxy. Local Ollama at http://localhost:11434 needs no key.
OLLAMA_API_KEY="ollama_secret_key_here"
# Ollama Cloud (https://ollama.com/api) — metered per-token usage. NOT free.
# Check plan limits and pricing at https://ollama.com/cloud/pricing before
# enabling. Distinct from local Ollama (which is free on your hardware).
# Leave unset to keep Ollama Cloud disabled.
OLLAMA_CLOUD_API_KEY=""

GOOGLE_AI_STUDIO_KEY="AIzaSy...GoogleAIStudioKey"
GEMINI_API_KEY="AIzaSy...GeminiKey"
# Hosted inference backends used only when AI_PROVIDER selects them explicitly.
GROQ_API_KEY="gsk_123456789abcdefghijklmnopqrstuvwxyz"
OPENROUTER_API_KEY="sk-or-v1-123456789abcdefghijklmnopqrstuvwxyz"
MISTRAL_API_KEY="mistral_api_key_123456789"
HF_API_TOKEN="hf_123456789abcdefghijklmnopqrstuvwxyz"
CLOUDFLARE_ACCOUNT_ID="1234567890abcdef1234567890abcdef"
CLOUDFLARE_API_TOKEN="cf_api_token_1234567890abcdef"

# Free public image endpoint; opt-in because it is a third-party call.
POLLINATIONS_IMAGE_ENABLED="true"

# Local speech-to-text (OpenAI-compatible /v1/audio/transcriptions).
LOCAL_STT_BASE_URL="http://localhost:8080/v1"
LOCAL_STT_API_KEY="local_stt_secret_key"
LOCAL_STT_MODEL="whisper-1"


# ═════════════════════════════════════════════════════════════════════════════
# EMAIL DELIVERY (OPTIONAL)
# ═════════════════════════════════════════════════════════════════════════════
# Providers are tried in this order: Resend, Brevo, generic webhook. With none
# configured, POST /api/email/send returns 503 instead of pretending to send.
EMAIL_FROM="noreply@alolabs.net"
RESEND_API_KEY="re_123456789_abcdefghijklmnopqrstuvwxyz"
BREVO_API_KEY="xkeysib-123456789abcdefghijklmnopqrstuvwxyz-12345678"
EMAIL_WEBHOOK_URL="https://marketing.alolabs.net/api/webhooks/email"


# ═════════════════════════════════════════════════════════════════════════════
# SCRAPING (OPTIONAL)
# ═════════════════════════════════════════════════════════════════════════════
# Self-hosted Firecrawl-compatible endpoint. Unset = /api/scraper reports the
# capability as unavailable rather than fabricating crawl results.
FIRECRAWL_BASE_URL="http://localhost:3002"
FIRECRAWL_API_KEY="fc_secret_api_key_12345"


# ═════════════════════════════════════════════════════════════════════════════
# SMS / VOIP ALTERNATES (OPTIONAL)
# ═════════════════════════════════════════════════════════════════════════════
# Provider chain tried in priority order: Twilio → httpSMS → Telnyx → Domovina.
# When NONE are configured, /api/sms/send + /api/sms/otp + /api/sms/broadcast
# persist messages as 'simulation' (status='sent' but providerMessageId starts
# with 'sim_'). Set any one of these to enable real delivery.

# ── Twilio (primary) ─────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ── httpSMS (NdoleStudio — Android phone as gateway) ────────────────────────
HTTPSMS_API_KEY=""
HTTPSMS_FROM_NUMBER="+15550199"

# ── Telnyx ───────────────────────────────────────────────────────────────────
TELNYX_API_KEY=""
TELNYX_CONNECTION_ID=""
TELNYX_FROM_NUMBER="+15550198"

# ── sms.domovina.ai (self-hosted) ───────────────────────────────────────────
DOMOVINA_SMS_API_URL=""
DOMOVINA_SMS_API_KEY=""

# ═════════════════════════════════════════════════════════════════════════════
# SOCIAL PUBLISHING (Postiz adapter)
# ═════════════════════════════════════════════════════════════════════════════
# When Postiz is configured, POST /api/v1/social/publish + the
# /api/cron/social-publish cron deliver real posts to Facebook, Instagram,
# LinkedIn, X, TikTok, YouTube via Postiz's official OAuth integrations.
# When unconfigured, posts are marked 'scheduled' locally only (no false claim
# of delivery).
POSTIZ_BASE_URL=""
POSTIZ_API_KEY=""
POSTIZ_WORKSPACE_ID=""

# ── Cron auth ───────────────────────────────────────────────────────────────
# Required by /api/cron/* endpoints. Set to a strong random string and
# configure an external scheduler (systemd timer / GitHub Actions cron) to
# hit the endpoint with Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=""


# ═════════════════════════════════════════════════════════════════════════════
# MARKETING PROVIDER OAUTH  (not implemented — deliberately absent)
# ═════════════════════════════════════════════════════════════════════════════
# Meta Ads, Google Ads and WhatsApp Cloud API OAuth flows are NOT implemented
# in this codebase, so this template intentionally declares no variables for
# them. The integrations screen reports them as unconfigured. Do not add
# placeholder credentials: nothing reads them and it makes the deployment look
# connected when it is not. Provider app registration and business
# verification are prerequisites for implementing them.


# ═════════════════════════════════════════════════════════════════════════════
# BACKUPS
# ═════════════════════════════════════════════════════════════════════════════
# Directory for verified SQLite snapshots. Keep it on a mounted volume, outside
# the container writable layer. Default: <cwd>/backups
BACKUP_DIR="/var/backups/marketingos"
# Automatic backup pruning is disabled. Monitor disk usage and establish an
# owner-approved retention policy.


# ═════════════════════════════════════════════════════════════════════════════
# BUILD / DIAGNOSTICS
# ═════════════════════════════════════════════════════════════════════════════
# Set automatically by the Docker build (ARG GIT_COMMIT) and reported by
# /api/health so the deploy workflow can prove which commit is running.
GIT_COMMIT=""

# Legacy cPanel-style database variables. NOT used to connect; if present while
# DATABASE_URL is unset, /api/health adds a note explaining the mismatch.
DB_NAME="marketingos_db"
DB_HOST="localhost"


# ═════════════════════════════════════════════════════════════════════════════
# MAINTENANCE SCRIPTS ONLY (never read by the running application)
# ═════════════════════════════════════════════════════════════════════════════
# Token used by scripts/verify-reference-links.mjs to raise the GitHub API rate
# limit. Read-only public access is enough. Either name is accepted.
GITHUB_TOKEN="ghp_1234567890abcdefghijklmnopqrstuvwxyz"
GH_TOKEN="ghp_1234567890abcdefghijklmnopqrstuvwxyz"

# ═════════════════════════════════════════════════════════════════════════════
# LIVEKIT (Real-time voice + WebRTC + SIP)
# ═════════════════════════════════════════════════════════════════════════════
# Install LiveKit Server: https://docs.livekit.io/getting-started/vm/
# When configured, WebRTC browser calling + SIP/PSTN + AI agent dispatch work.
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# eCommerce delivery webhook secret
ECOMMERCE_WEBHOOK_SECRET=""
