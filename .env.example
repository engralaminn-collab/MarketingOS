# MarketingOS — environment template
#
# Copy to `.env` and fill in. `.env*` is gitignored; never commit real values.
#
#   cp .env.example .env
#
# Anything marked REQUIRED must be set or the application will refuse to start
# (or /api/health will report status "degraded" and the deploy will fail).

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Provider is SQLite (prisma/schema.prisma). The database is a plain FILE.
#
# In production this MUST be an absolute path inside a mounted volume,
# otherwise it lives in the container's writable layer and is destroyed every
# time the image is replaced. See docker-compose.prod.yml (./db:/app/db).
#
#   local dev :  file:./db/custom.db
#   container :  file:/app/db/custom.db
#
# A relative path resolves against each process's working directory, so the
# app, prisma and the backup script can end up on different files. Use an
# absolute path anywhere it matters.
DATABASE_URL="file:./db/custom.db"

# ─────────────────────────────────────────────────────────────────────────────
# AUTH  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Signing key for session tokens. Generate a fresh one per environment:
#
#   openssl rand -hex 32
#
# Rotating it invalidates every existing session, which is the correct response
# to a suspected leak.
JWT_SECRET=""

# Optional dashboard release controller (GitHub Actions workflow_dispatch).
# Create a least-privilege token with Actions: read/write on this repository;
# keep it only in the server environment, never in browser configuration.
DEPLOY_GITHUB_REPOSITORY="owner/repository"
DEPLOY_GITHUB_TOKEN=""
DEPLOY_GITHUB_WORKFLOW="deploy.yml"
DEPLOY_GITHUB_BRANCH="main"

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN BOOTSTRAP  (seeding only)
# ─────────────────────────────────────────────────────────────────────────────
# Password for the seeded administrator. There is deliberately NO default.
#
#   production      : REQUIRED. Seeding aborts if unset.
#   non-production  : optional. A random one is generated and printed once.
#
# Set it to a value from your password manager, and rotate it after first
# login. It is only read by prisma/seed.ts — never by the running app.
ADMIN_SEED_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# CREDENTIAL ENCRYPTION  (required once the credential vault is in use)
# ─────────────────────────────────────────────────────────────────────────────
# Required to encrypt social-account access tokens at rest (AES-256-GCM).
# 32 bytes, hex-encoded:
#
#   openssl rand -hex 32
#
# Losing this makes every stored credential unrecoverable — back it up
# separately from the database. Changing it requires re-encrypting existing
# rows; do not rotate it casually.
CREDENTIAL_ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# SETUPBOT (optional; see docs/SETUP-BOT.md)
# ─────────────────────────────────────────────────────────────────────────────
# Choose a Graph API version supported by your Meta app. v19.0 is the requested
# default, but providers retire versions; verification fails explicitly if retired.
META_GRAPH_API_VERSION="v19.0"
# Optional extra questions (at most 12). Fields are optional and saved encrypted.
# Example: [{"key":"shop_id","labelEn":"Shop ID","labelBn":"শপ আইডি","secret":false}]
SETUP_CUSTOM_FIELDS="[]"
# Trusted inbound import bearer and optional outbound handoff. Never expose these
# as NEXT_PUBLIC_* values. Generate an independent random token with openssl.
# A blank base URL uses the local MarketingOS workspace only. If configured,
# map each local company ID to its receiving project's company ID. The receiver
# must have the same credential-encryption key to read encrypted payload fields.
ADMIN_SERVICE_TOKEN=""
SETUP_HANDOFF_BASE_URL=""
SETUP_HANDOFF_PROJECT_MAP="{}"

# ─────────────────────────────────────────────────────────────────────────────
# SMS PROVIDER — Twilio  (optional)
# ─────────────────────────────────────────────────────────────────────────────
# SMS sending is disabled regardless of these settings: the routes return 503
# without sending or creating message rows until consent, suppression and
# provider delivery verification are implemented.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─────────────────────────────────────────────────────────────────────────────
# SELF-HOSTED AI TEXT PROVIDER (Ollama is the default; no paid fallback)
# ─────────────────────────────────────────────────────────────────────────────
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_CHAT_MODEL="qwen2.5:7b"
AI_REQUEST_TIMEOUT_MS="120000"

# Optional explicitly configured OpenAI-compatible endpoint. Use this for a
# self-hosted vLLM/local inference server, not as an automatic cloud fallback.
AI_COMPATIBLE_BASE_URL=""
AI_COMPATIBLE_MODEL=""
AI_COMPATIBLE_API_KEY=""

# Self-hosted image generation (AUTOMATIC1111 / Stable Diffusion WebUI API)
IMAGE_GENERATION_URL="http://127.0.0.1:7860"
IMAGE_GENERATION_TIMEOUT_MS="120000"

# Self-hosted media adapters. These are optional; unavailable services return
# explicit errors and are never replaced by paid cloud APIs.
VIDEO_GENERATION_URL=""
VIDEO_GENERATION_TIMEOUT_MS="120000"
TTS_SERVICE_URL=""
TTS_TIMEOUT_MS="60000"

# Optional self-hosted image generation through a private ComfyUI server.
# MarketingOS sends a standard checkpoint-based workflow to this server; you
# install ComfyUI and download/license the checkpoint yourself. If configured,
# a ComfyUI failure never falls back to a hosted provider.
COMFYUI_BASE_URL=""
COMFYUI_IMAGE_CHECKPOINT=""
COMFYUI_API_KEY=""
# Optional ComfyUI API-format video workflow. This must be an operator-owned JSON
# workflow with {{PROMPT}} and {{FRAMES}} placeholders. Models/nodes are separate.
COMFYUI_VIDEO_WORKFLOW_FILE=""
COMFYUI_VIDEO_FPS="12"
COMFYUI_VIDEO_WIDTH="768"
COMFYUI_VIDEO_HEIGHT="512"

# Optional self-hosted OpenAI-compatible TTS service exposing /v1/audio/speech.
# A configured local failure never falls back to a hosted provider.
LOCAL_TTS_BASE_URL=""
LOCAL_TTS_MODEL="tts-1"
LOCAL_TTS_VOICE="default"
LOCAL_TTS_API_KEY=""

# Lip-sync is currently disabled even if these legacy settings are populated.
# Consented workspace-asset binding and a durable worker are required before any
# photo or audio can be sent to an adapter. No hosted fallback is attempted.
LIPSYNC_ADAPTER_URL=""
LIPSYNC_TIMEOUT_MS="180000"

# Hosted image, video, avatar, and speech generation makes external provider
# calls and is intentionally disabled by default. Set true only if you
# explicitly want the Z.AI media adapter and accept any applicable charges.
ZAI_MEDIA_ENABLED="false"
# Mureka is a separate optional instrumental API. Configure its key in
# Integrations only if you want to use it; provider charges may apply.

# ─────────────────────────────────────────────────────────────────────────────
# MARKETING PROVIDER OAUTH  (not implemented — deliberately absent)
# ─────────────────────────────────────────────────────────────────────────────
# Meta Ads, Google Ads and WhatsApp Cloud API OAuth flows are NOT implemented
# in this codebase, so this template intentionally declares no variables for
# them. The integrations screen reports them as unconfigured. Do not add
# placeholder credentials: nothing reads them and it makes the deployment look
# connected when it is not. Provider app registration and business
# verification are prerequisites for implementing them.

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
HOSTNAME="0.0.0.0"

# NOTE: PORT and HOSTNAME above are read by the Next.js standalone server
# (`node server.js`), not by application code. GIT_COMMIT is injected by the
# Dockerfile; leave it unset everywhere else.

# ─────────────────────────────────────────────────────────────────────────────
# SITE IDENTITY (canonical URLs in metadata, robots.txt and sitemap.xml)
# ─────────────────────────────────────────────────────────────────────────────
# Single source of truth for every absolute URL the app emits. Must match the
# public origin terminated by the reverse proxy; a wrong value silently points
# search engines and Open Graph cards at another host.
NEXT_PUBLIC_SITE_URL="https://www.kexsio.com"
# Used for provider referrer headers (OpenRouter-compatible endpoints).
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN BOOTSTRAP IDENTITY (seeding only — read by prisma/seed.ts)
# ─────────────────────────────────────────────────────────────────────────────
# Login address of the seeded administrator. Password comes from
# ADMIN_SEED_PASSWORD above.
ADMIN_SEED_EMAIL=""

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL DELIVERY (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Providers are tried in this order: Resend, Brevo, generic webhook. With none
# configured, POST /api/email/send returns 503 instead of pretending to send.
EMAIL_FROM=""
RESEND_API_KEY=""
BREVO_API_KEY=""
EMAIL_WEBHOOK_URL=""

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDERS — additional self-hosted or explicitly configured backends
# ─────────────────────────────────────────────────────────────────────────────
# Explicit fallback order for text generation, e.g. "ollama,openai-compatible".
# Empty means no fallback: a failed primary is reported as a failure.
AI_FALLBACK_CHAIN=""
# Embeddings for RAG. "local" uses Ollama; "gemini" uses GEMINI_API_KEY.
AI_EMBED_PROVIDER="local"
OLLAMA_EMBED_MODEL="bge-m3"
# Only set if your Ollama instance sits behind an authenticated proxy.
OLLAMA_API_KEY=""
GOOGLE_AI_STUDIO_KEY=""
GEMINI_API_KEY=""
# Hosted inference backends used only when AI_PROVIDER selects them explicitly.
GROQ_API_KEY=""
HF_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_API_TOKEN=""
# Free public image endpoint; opt-in because it is a third-party call.
POLLINATIONS_IMAGE_ENABLED="false"
# Local speech-to-text (OpenAI-compatible /v1/audio/transcriptions).
LOCAL_STT_BASE_URL=""
LOCAL_STT_API_KEY=""
LOCAL_STT_MODEL="whisper-1"

# ─────────────────────────────────────────────────────────────────────────────
# SCRAPING (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Self-hosted Firecrawl-compatible endpoint. Unset = /api/scraper reports the
# capability as unavailable rather than fabricating crawl results.
FIRECRAWL_BASE_URL=""
FIRECRAWL_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# SMS / VOIP ALTERNATES (optional)
# ─────────────────────────────────────────────────────────────────────────────
# Twilio is the primary SMS provider (see above). HTTP SMS and Telnyx are
# supported alternates; absent credentials make /api/sms/send and
# /api/voip/call report "not configured".
HTTPSMS_API_KEY=""
HTTPSMS_FROM_NUMBER=""
TELNYX_API_KEY=""
TELNYX_CONNECTION_ID=""
TELNYX_FROM_NUMBER=""

# ─────────────────────────────────────────────────────────────────────────────
# BACKUPS
# ─────────────────────────────────────────────────────────────────────────────
# Directory for verified SQLite snapshots. Keep it on a mounted volume, outside
# the container writable layer. Default: <cwd>/backups
BACKUP_DIR=""
# Automatic backup pruning is disabled. Monitor disk usage and establish an owner-approved retention policy.

# ─────────────────────────────────────────────────────────────────────────────
# BUILD / DIAGNOSTICS
# ─────────────────────────────────────────────────────────────────────────────
# Set automatically by the Docker build (ARG GIT_COMMIT) and reported by
# /api/health so the deploy workflow can prove which commit is running.
GIT_COMMIT=""
# Legacy cPanel-style database variables. NOT used to connect; if present while
# DATABASE_URL is unset, /api/health adds a note explaining the mismatch.
DB_NAME=""
DB_HOST=""

# ─────────────────────────────────────────────────────────────────────────────
# MAINTENANCE SCRIPTS ONLY (never read by the running application)
# ─────────────────────────────────────────────────────────────────────────────
# Token used by scripts/verify-reference-links.mjs to raise the GitHub API rate
# limit. Read-only public access is enough. Either name is accepted.
GITHUB_TOKEN=""
GH_TOKEN=""
