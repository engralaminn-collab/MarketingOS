# MarketingOS — environment template
#
# Copy to `.env` and fill in. `.env*` is gitignored; never commit real values.
#
#   cp .env.example .env
#
# Anything marked REQUIRED must be set or the application will refuse to start
# (or /api/health will report status "degraded" and the deploy will fail).

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Provider is SQLite (prisma/schema.prisma). The database is a plain FILE.
#
# In production this MUST be an absolute path inside a mounted volume,
# otherwise it lives in the container's writable layer and is destroyed every
# time the image is replaced. See docker-compose.prod.yml (./db:/app/db).
#
#   local dev :  file:./db/custom.db
#   container :  file:/app/db/custom.db
#
# A relative path resolves against each process's working directory, so the
# app, prisma and the backup script can end up on different files. Use an
# absolute path anywhere it matters.
DATABASE_URL="file:./db/custom.db"

# ─────────────────────────────────────────────────────────────────────────────
# AUTH  (REQUIRED)
# ─────────────────────────────────────────────────────────────────────────────
# Signing key for session tokens. Generate a fresh one per environment:
#
#   openssl rand -hex 32
#
# Rotating it invalidates every existing session, which is the correct response
# to a suspected leak.
JWT_SECRET=""

# ─────────────────────────────────────────────────────────────────────────────
# ADMIN BOOTSTRAP  (seeding only)
# ─────────────────────────────────────────────────────────────────────────────
# Password for the seeded administrator. There is deliberately NO default.
#
#   production      : REQUIRED. Seeding aborts if unset.
#   non-production  : optional. A random one is generated and printed once.
#
# Set it to a value from your password manager, and rotate it after first
# login. It is only read by prisma/seed.ts — never by the running app.
ADMIN_SEED_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# CREDENTIAL ENCRYPTION  (required once the credential vault is in use)
# ─────────────────────────────────────────────────────────────────────────────
# Key for encrypting stored third-party credentials at rest (AES-256-GCM).
# 32 bytes, hex-encoded:
#
#   openssl rand -hex 32
#
# Losing this makes every stored credential unrecoverable — back it up
# separately from the database. Changing it requires re-encrypting existing
# rows; do not rotate it casually.
CREDENTIAL_ENCRYPTION_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# SMS PROVIDER — Twilio  (optional)
# ─────────────────────────────────────────────────────────────────────────────
# If any of these is unset, /api/sms/send records the message as `blocked`
# and returns 503. It never reports a message as sent without a provider
# acknowledgement.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# ─────────────────────────────────────────────────────────────────────────────
# OPTIONAL PAGE SCRAPING — operator-managed Firecrawl (no hosted default)
# ─────────────────────────────────────────────────────────────────────────────
# Leave FIRECRAWL_BASE_URL empty to use MarketingOS's built-in, DNS-pinned,
# no-redirect public-page fetcher. Setting a URL opts in to that exact Firecrawl
# service; failures do not fall back to another service or provider.
# For self-hosting, use your private service URL, e.g. http://firecrawl:3002.
# The Firecrawl crawler must enforce its own SSRF/egress policy: MarketingOS
# pre-validates targets but cannot DNS-pin a fetch performed by another server.
# Only configure a hosted endpoint/API key if you have reviewed its price,
# retention, and data-processing terms.
FIRECRAWL_BASE_URL=""
FIRECRAWL_API_KEY=""

# ─────────────────────────────────────────────────────────────────────────────
# AI PROVIDER  (self-hosted text model by default; no paid API required)
# ─────────────────────────────────────────────────────────────────────────────
# MarketingOS server-side text features (AI chat, marketing copy, agents,
# diagrams, grammar, and video-plan scripts) use Ollama by default. Install
# Ollama, pull the model, and point this URL at the private model server.
# Local dev on the same host: http://127.0.0.1:11434
# Docker Compose overlay:  http://ollama:11434
AI_PROVIDER="ollama"
OLLAMA_BASE_URL="http://127.0.0.1:11434"
OLLAMA_MODEL="llama3.2:3b"
# Optional bearer secret when Ollama is behind an authenticated reverse proxy.
OLLAMA_API_KEY=""

# Optional text alternatives. These are never selected automatically:
# AI_PROVIDER="openrouter" requires an OpenRouter key saved in Integrations.
# AI_PROVIDER="zai" uses the hosted z-ai-web-dev-sdk adapter.
ZAI_API_KEY=""

# Optional self-hosted image generation through a private ComfyUI server.
# MarketingOS sends a standard checkpoint-based workflow to this server; you
# install ComfyUI and download/license the checkpoint yourself. If configured,
# a ComfyUI failure never falls back to a hosted provider.
COMFYUI_BASE_URL=""
COMFYUI_IMAGE_CHECKPOINT=""
COMFYUI_API_KEY=""
# Optional ComfyUI API-format video workflow. This must be an operator-owned JSON
# workflow with {{PROMPT}} and {{FRAMES}} placeholders. Models/nodes are separate.
COMFYUI_VIDEO_WORKFLOW_FILE=""
COMFYUI_VIDEO_FPS="12"
COMFYUI_VIDEO_WIDTH="768"
COMFYUI_VIDEO_HEIGHT="512"

# Optional self-hosted OpenAI-compatible TTS service exposing /v1/audio/speech.
# A configured local failure never falls back to a hosted provider.
LOCAL_TTS_BASE_URL=""
LOCAL_TTS_MODEL="tts-1"
LOCAL_TTS_VOICE="default"
LOCAL_TTS_API_KEY=""

# Hosted image, video, avatar, and speech generation makes external provider
# calls and is intentionally disabled by default. Set true only if you
# explicitly want the Z.AI media adapter and accept any applicable charges.
ZAI_MEDIA_ENABLED="false"
# Mureka is a separate optional instrumental API. Configure its key in
# Integrations only if you want to use it; provider charges may apply.

# ─────────────────────────────────────────────────────────────────────────────
# MARKETING PROVIDERS  (optional — not yet implemented)
# ─────────────────────────────────────────────────────────────────────────────
# Placeholders for the integrations that still need real OAuth flows. Each
# requires app registration and business verification with the provider before
# it can work. Leaving them blank keeps the corresponding feature reporting
# itself as unconfigured rather than pretending to be connected.
META_APP_ID=""
META_APP_SECRET=""
META_REDIRECT_URI=""

GOOGLE_ADS_CLIENT_ID=""
GOOGLE_ADS_CLIENT_SECRET=""
GOOGLE_ADS_DEVELOPER_TOKEN=""

WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_VERIFY_TOKEN=""

# ─────────────────────────────────────────────────────────────────────────────
# RUNTIME
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"
PORT="3000"
HOSTNAME="0.0.0.0"
