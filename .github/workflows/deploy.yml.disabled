name: Deploy to VPS

on:
  workflow_dispatch:
    inputs:
      image_tag:
        description: "Image tag to deploy (defaults to latest)"
        required: false
        default: "latest"

concurrency:
  group: deploy-production
  cancel-in-progress: false

timeout-minutes: 20

jobs:
  deploy:
    name: Deploy to VPS
    runs-on: ubuntu-24.04
    timeout-minutes: 18
    if: ${{ secrets.DEPLOY_HOST != '' && secrets.DEPLOY_SSH_KEY != '' }}
    environment:
      name: production
    steps:
      - uses: actions/checkout@v4

      - name: Verify required secrets
        run: |
          if [ -z "${{ secrets.DEPLOY_HOST }}" ] || [ -z "${{ secrets.DEPLOY_SSH_KEY }}" ]; then
            echo "⚠️ Deploy secrets not configured — skipping"
            exit 0
          fi
          echo "✅ Deploy secrets present"

      - name: Configure SSH
        run: |
          mkdir -p ~/.ssh
          printf '%s\n' "${{ secrets.DEPLOY_SSH_KEY }}" > ~/.ssh/deploy_key
          chmod 600 ~/.ssh/deploy_key
          ssh-keyscan -p ${{ secrets.DEPLOY_PORT || '22' }} -H ${{ secrets.DEPLOY_HOST }} >> ~/.ssh/known_hosts 2>/dev/null

      - name: Deploy
        run: |
          ssh -i ~/.ssh/deploy_key -p ${{ secrets.DEPLOY_PORT || '22' }} ${{ secrets.DEPLOY_USER || 'deploy' }}@${{ secrets.DEPLOY_HOST }} << 'SSH_EOF'
            cd /opt/marketingos
            docker compose pull
            docker compose up -d --force-recreate
            sleep 10
            curl -sf http://localhost:3055/api/health || echo "⚠️ Health check failed"
          SSH_EOF

      - name: Summary
        run: echo "## Deploy Summary" >> $GITHUB_STEP_SUMMARY
        continue-on-error: true
