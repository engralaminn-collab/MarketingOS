generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ==================== MULTI-TENANT COMPANY ====================

model Company {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  logo        String?
  website     String?
  industry    String?
  country     String?
  brandColors String?
  targetAudience String?
  marketingGoals String?
  plan        String   @default("free")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users         CompanyUser[]
  socialAccounts SocialAccount[]
  campaigns     Campaign[]
  contents      Content[]
  seoChallenges SeoChallenge[]
  leads         Lead[]
  contacts      Contact[]
  deals         Deal[]
  tickets       Ticket[]
  aiAgents      AiAgent[]
  auditLogs     AuditLog[]
  subscriptions Subscription[]
  invitations   Invitation[]
  departments   Department[]
  employees     Employee[]
  knowledgeNodes KnowledgeNode[]
  toolConnections ToolConnection[]
  webhooks        Webhook[]
  apiKeys         ApiKey[]
  announcements   Announcement[]
  activities      Activity[]
  feedSources     FeedSource[]
  feedItems       FeedItem[]
  smsMessages     SmsMessage[]
  competitors     Competitor[]
  keywordTrackers KeywordTracker[]
  workflows       Workflow[]
  workflowRuns    WorkflowRun[]
  integrations    Integration[]
  oauthStates     OAuthState[]
  integrationManifests IntegrationManifest[]
  agentModelAssignments AgentModelAssignment[]
  agentUsageDailies AgentUsageDaily[]
  agentExecutionLogs  AgentExecutionLog[]
  afterHoursRule  AfterHoursRule[]
  // Phase 1-6 voice/contact-center relations
  voiceAgents     VoiceAgent[]
  consents        Consent[]
  callUsageDailies CallUsageDaily[]
  ttsUsageDailies TtsUsageDaily[]
  asrUsageDailies AsrUsageDaily[]
  phoneNumbers    PhoneNumber[]
  calls           Call[]
  ivrMenus        IvrMenu[]
  ringGroups      RingGroup[]
  callQueues      CallQueue[]
  voicemails      Voicemail[]
  voiceCloneAuthorizations VoiceCloneAuthorization[]
  pronunciationDictionaries PronunciationDictionary[]
  ttsJobs         TtsJob[]
  outboundCampaigns OutboundCampaign[]
  agentStatuses   AgentStatus[]
  supervisorActions SupervisorAction[]
  customers       Customer[]
  sharedInboxMessages SharedInboxMessage[]
  knowledgeBases  KnowledgeBase[]
  subscription    TenantSubscription?
  usageCredits    UsageCredit[]
  invoices        Invoice[]
  payments       Payment[]
  billingAdjustments BillingAdjustment[]
  expenses     Expense[]
  skills       Skill[]
  prompts      Prompt[]
  agentProfiles AgentProfile[]
  suppressionList SuppressionList[]
  // ── Universal Lead Discovery Engine relations (Requirements 3-15) ──
  industryId           String?
  countryId            String?
  defaultAutonomyLevel String  @default("approval_required") // suggest_only|approval_required|approved_automation
  defaultBudgetPreference String @default("free_first") // free_only|free_first|paid_with_approval
  discoveryCampaigns   DiscoveryCampaign[]
  discoveredLeads      DiscoveredLead[]
  dataProviders        DataProvider[]
  approvalRequests     ApprovalRequest[]
  costEvents           CostEvent[]
  websiteAudits        WebsiteAudit[]
  socialMetrics        SocialAudienceMetric[]
  contentCalendarItems ContentCalendarItem[]
  retentionPolicies    DataRetentionPolicy[]
  marketOpportunities  MarketOpportunity[]
}

// ==================== USER & ROLES ====================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  phone         String?
  avatar        String?
  isActive      Boolean   @default(true)
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  companyUsers  CompanyUser[]
  auditLogs     AuditLog[]
  aiChatMessages AiChatMessage[]
  createdContents Content[] @relation("ContentCreator")
  sessions      UserSession[]
  notifications  Notification[]  // notifications addressed to this user
  sentMessages   Message[]  @relation("MessageSender")
  receivedMessages Message[] @relation("MessageRecipient")
  announcements  Announcement[] @relation("AnnouncementCreator")
  activities     Activity[] @relation("ActivityActor")
  sentSms        SmsMessage[] @relation("SmsSender")
  createdWorkflows Workflow[] @relation("WorkflowCreator")
  integrationCreated  Integration[] @relation("IntegrationCreator")
  integrationUpdated  Integration[] @relation("IntegrationUpdater")
  oauthStates         OAuthState[] @relation("OAuthStateUser")
  confirmedManifests  IntegrationManifest[] @relation("ManifestConfirmer")
  createdAiProviders  AiModelProvider[] @relation("AiModelProviderCreator")
  updatedAiProviders  AiModelProvider[] @relation("AiModelProviderUpdater")
  createdAgentAssignments  AgentModelAssignment[] @relation("AgentAssignmentCreator")
  updatedAgentAssignments  AgentModelAssignment[] @relation("AgentAssignmentUpdater")
  agentExecutionLogs  AgentExecutionLog[] @relation("AgentExecutionActor")
  passwordResets  PasswordReset[] @relation("PasswordResetUser")
  // Phase 1-6 voice/contact-center relations
  mfaSecret       MfaSecret?   @relation("MfaSecretUser")
  refreshTokens   RefreshToken[] @relation("RefreshTokenUser")
  createdVoiceAgents VoiceAgent[] @relation("VoiceAgentCreator")
  updatedVoiceAgents VoiceAgent[] @relation("VoiceAgentUpdater")
  createdPhoneNumbers PhoneNumber[] @relation("PhoneNumberCreator")
  createdCalls    Call[]  @relation("CallCreator")
  createdIvrMenus IvrMenu[] @relation("IvrMenuCreator")
  capturedVoiceCloneAuths VoiceCloneAuthorization[] @relation("VoiceCloneAuthCreator")
  createdTtsJobs  TtsJob[] @relation("TtsJobCreator")
  createdCampaigns OutboundCampaign[] @relation("CampaignCreator")
  agentStatus     AgentStatus?  @relation("AgentStatusUser")
  supervisorActions SupervisorAction[] @relation("SupervisorActor")
  createdCustomers Customer[] @relation("CustomerCreator")
  uploadedKnowledgeDocs KnowledgeDocument[] @relation("KnowledgeDocCreator")
  createdPayments Payment[] @relation("PaymentCreator")
  createdBillingAdjustments BillingAdjustment[] @relation("BillingAdjustmentCreator")
  approvedBillingAdjustments BillingAdjustment[] @relation("BillingAdjustmentApprover")
  createdExpenses Expense[] @relation("ExpenseCreator")
}

model CompanyUser {
  id          String   @id @default(cuid())
  role        String   @default("team_member")
  permissions String   @default("{}")
  joinedAt    DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])

  leadsAssigned      Lead[]  @relation("LeadAssignee")
  ticketsAssigned    Ticket[] @relation("TicketAssignee")
  ticketMessages     TicketMessage[]

  @@unique([userId, companyId])
}

// ==================== SOCIAL MEDIA ACCOUNTS ====================

model SocialAccount {
  id              String   @id @default(cuid())
  platform        String
  accountName     String
  accountHandle   String?
  accountId       String?
  avatarUrl       String?
  accessToken     String
  refreshToken    String?
  tokenExpiresAt  DateTime?
  scopes          String   @default("[]")
  webhookUrl      String?
  status          String   @default("active")
  lastSyncedAt    DateTime?
  connectedAt     DateTime @default(now())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== CONTENT & MEDIA ====================

model Content {
  id            String   @id @default(cuid())
  title         String
  type          String
  status        String   @default("draft")
  platform      String?
  body          String?
  mediaUrl      String?
  mediaType     String?
  thumbnailUrl  String?
  hashtags      String?
  scheduledAt   DateTime?
  publishedAt   DateTime?
  engagement    String   @default("{}")
  aiGenerated   Boolean  @default(false)
  creatorId     String?
  creator       User?    @relation("ContentCreator", fields: [creatorId], references: [id])
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  campaignId    String?
  campaign      Campaign? @relation(fields: [campaignId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// ==================== CAMPAIGNS ====================

model Campaign {
  id          String   @id @default(cuid())
  name        String
  type        String
  status      String   @default("draft")
  budget      Float?
  startDate   DateTime?
  endDate     DateTime?
  metrics     String   @default("{}")
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  contents Content[]
}

// ==================== CRM ====================

model Lead {
  id            String   @id @default(cuid())
  name          String
  email         String?
  phone         String?
  companyName   String?
  source        String?
  status        String   @default("discovered") // Universal lifecycle: discovered→data_validation→qualification_review→qualified→assigned→contact_permitted→contacted→follow_up→opportunity→customer→closed | rejected|duplicate|unverified|do_not_contact|opted_out|data_expired
  score         Int      @default(0)
  notes         String?
  assignedToId  String?
  assignedTo    CompanyUser? @relation("LeadAssignee", fields: [assignedToId], references: [id])
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  dealId        String?
  deal          Deal?    @relation(fields: [dealId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // ── Public lead discovery provenance (Requirement 6) ──────────────
  sourceUrl          String?   // Source URL where the lead was discovered
  discoveryTimestamp DateTime? // When the lead was discovered
  confidenceLevel    String?   @default("medium") // low|medium|high
  dataFreshness      String?   @default("fresh")  // fresh|recent|stale|expired
  reviewStatus       String?   @default("pending") // pending|reviewed|approved|rejected
  applicableUsageRestrictions String? // Licensing/reuse restrictions from the source
  dedupHash          String?   @unique // Normalized hash for automatic deduplication
  contactPermitted   Boolean   @default(false) // Legal basis + consent verified before contact
  optedOut           Boolean   @default(false)
  dataExpiresAt      DateTime? // Retention expiry — auto-delete after this date
  industryId         String?
  countryId          String?
  campaignId         String?
  discoveredLeadId   String?   // Links to DiscoveredLead record if discovered via the engine

  activities  LeadActivity[]
  tags        LeadTag[]
  scoreBreakdowns    LeadScoreBreakdown[]
  intentSignals      BuyerIntentSignal[]
  approvalRequests   ApprovalRequest[]
}

model Contact {
  id          String   @id @default(cuid())
  name        String
  email       String?
  phone       String?
  companyName String?
  position    String?
  source      String?
  notes       String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Deal {
  id          String   @id @default(cuid())
  name        String
  value       Float    @default(0)
  stage       String   @default("prospect")
  probability Int      @default(0)
  closeDate   DateTime?
  notes       String?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leads  Lead[]
}

model Ticket {
  id          String   @id @default(cuid())
  subject     String
  description String?
  status      String   @default("open")
  priority    String   @default("medium")
  assignedToId String?
  assignedTo  CompanyUser? @relation("TicketAssignee", fields: [assignedToId], references: [id])
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  messages TicketMessage[]
}

model TicketMessage {
  id        String   @id @default(cuid())
  content   String
  senderId  String?
  sender    CompanyUser? @relation(fields: [senderId], references: [id])
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id])
  createdAt DateTime @default(now())
}

model LeadActivity {
  id        String   @id @default(cuid())
  type      String
  content   String?
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())
}

model LeadTag {
  id        String   @id @default(cuid())
  name      String
  leadId    String
  lead      Lead     @relation(fields: [leadId], references: [id])
  createdAt DateTime @default(now())
}

// ==================== SEO ====================

model SeoChallenge {
  id             String   @id @default(cuid())
  name           String
  websiteUrl     String
  targetKeywords String?
  duration       Int      @default(60)
  status         String   @default("active")
  currentDay     Int      @default(0)
  score          Int      @default(0)
  tasks          String   @default("[]")
  results        String   @default("{}")
  companyId      String
  company        Company  @relation(fields: [companyId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  dailyTasks SeoDailyTask[]
}

model SeoDailyTask {
  id             String   @id @default(cuid())
  day            Int
  title          String
  description    String?
  category       String
  status         String   @default("pending")
  completedAt    DateTime?
  challengeId    String
  challenge      SeoChallenge @relation(fields: [challengeId], references: [id])
  createdAt      DateTime @default(now())
}

// ==================== AI AGENTS (LEGACY - KEPT FOR BACKWARD COMPAT) ====================

model AiAgent {
  id          String   @id @default(cuid())
  name        String
  type        String
  description String?
  config      String   @default("{}")
  isEnabled   Boolean  @default(true)
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AiChatMessage {
  id        String   @id @default(cuid())
  role      String
  content   String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
}

// ==================== SUBSCRIPTIONS ====================

model Subscription {
  id          String   @id @default(cuid())
  plan        String
  billingCycle String  @default("monthly")
  amount      Float
  status      String   @default("active")
  startsAt    DateTime @default(now())
  endsAt      DateTime?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ==================== INVITATIONS ====================

model Invitation {
  id          String   @id @default(cuid())
  email       String
  role        String   @default("team_member")
  token       String   @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id])
  createdAt   DateTime @default(now())
}

// ==================== AUDIT LOG ====================

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  resource   String
  resourceId String?
  details    String?
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  companyId  String?
  company    Company?  @relation(fields: [companyId], references: [id])
  createdAt  DateTime @default(now())
}

// ==================== NOTIFICATIONS ====================

model Notification {
  id          String    @id @default(cuid())
  userId      String                    // recipient — user who should see it
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String                    // lead.created | deal.won | ticket.assigned | campaign.completed | system | announcement
  title       String
  message     String
  link        String?                  // URL to navigate to when clicked
  isRead      Boolean   @default(false)
  readAt      DateTime?
  metadata    String    @default("{}") // JSON: extra context
  createdAt   DateTime  @default(now())

  @@index([userId, isRead])
  @@index([createdAt])
}

// ==================== MESSAGES (Chatwoot-style inbox) ====================

model Message {
  id           String    @id @default(cuid())
  content      String
  senderId     String
  sender       User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId  String
  recipient    User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  isRead       Boolean   @default(false)
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([senderId, recipientId])
  @@index([recipientId, isRead])
}

// ==================== ANNOUNCEMENTS ====================

model Announcement {
  id           String    @id @default(cuid())
  title        String
  content      String
  priority     String    @default("normal")  // low | normal | high
  targetRoles  String    @default("all")      // JSON array of role keys, or "all"
  isActive     Boolean   @default(true)
  expiresAt    DateTime?
  createdBy    String?
  creator      User?     @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ==================== ACTIVITY FEED (company-wide) ====================

model Activity {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?     @relation("ActivityActor", fields: [userId], references: [id])
  type         String                    // lead.created | deal.won | content.published | campaign.completed | ...
  description  String
  resourceType String?                  // lead | deal | contact | ticket | campaign | content | ...
  resourceId   String?
  metadata     String    @default("{}") // JSON
  createdAt    DateTime  @default(now())

  @@index([companyId, createdAt])
}

// ========================================================================
// AI WORKFORCE - THE 2,000 EMPLOYEE SYSTEM
// ========================================================================

// ==================== DEPARTMENTS ====================
// Organizational departments that house AI employees

model Department {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique  // e.g. "MKT", "ENG", "FIN"
  description   String?
  parentId      String?               // For sub-departments
  parent        Department?  @relation("DeptHierarchy", fields: [parentId], references: [id])
  children      Department[]  @relation("DeptHierarchy")
  level         Int      @default(0)  // 0=executive, 1=director, 2=department, 3=team
  sortOrder     Int      @default(0)
  icon          String?
  color         String?
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id])
  prompts       Prompt[] @relation("PromptDepartment")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  employees     Employee[]
  sops          Sop[]
  knowledgeNodes KnowledgeNode[]
}

// ==================== EMPLOYEE (AI EMPLOYEE) ====================
// Each AI Employee is a specialized agent with identity, role, skills, KPIs

model Employee {
  id              String   @id @default(cuid())
  employeeId      String   @unique     // e.g. "EMP-0001"
  name            String
  title           String               // e.g. "Chief Marketing Officer"
  level           String   @default("specialist") // executive, director, manager, supervisor, specialist, worker
  status          String   @default("idle")       // idle, working, busy, offline, training
  avatar          String?
  mission         String               // What this employee exists to do
  constitution     String?              // Behavioral rules and constraints
  authority       String   @default("{}") // JSON: what they can authorize
  permissions     String   @default("{}") // JSON: RBAC permissions

  // Specialization
  departmentId    String
  department      Department @relation(fields: [departmentId], references: [id])
  reportsToId     String?
  reportsTo       Employee?  @relation("EmpHierarchy", fields: [reportsToId], references: [id])
  directReports   Employee[]  @relation("EmpHierarchy")

  // Skills & Capabilities
  skills          String   @default("[]") // JSON array of skill IDs/names
  capabilities    String   @default("[]") // JSON: what this employee can DO
  tools           String   @default("[]") // JSON: tools this employee can use

  // Model Configuration
  preferredModel  String?              // Preferred AI model for this employee
  modelTier       String   @default("balanced") // fast, balanced, reasoning, coding, vision, specialized
  modelConfig     String   @default("{}") // JSON: model-specific config

  // KPIs & Performance
  kpis            String   @default("[]") // JSON: KPI definitions
  currentKpis     String   @default("{}") // JSON: current KPI values
  totalTasks      Int      @default(0)
  completedTasks  Int      @default(0)
  failedTasks     Int      @default(0)
  successRate     Float    @default(0)
  avgLatencyMs    Int      @default(0)
  lastActiveAt    DateTime?

  // Collaboration Rules
  canDelegate     Boolean  @default(false)
  canConsult      Boolean  @default(true)
  canReview       Boolean  @default(false)
  canEscalate     Boolean  @default(true)
  collaborationRules String @default("{}")

  // Escalation
  escalationRules String   @default("[]") // JSON: when/how to escalate
  escalationPath  String   @default("[]") // JSON: chain of escalation

  // System
  isEnabled       Boolean  @default(true)
  isAvailable     Boolean  @default(true)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  executions      TaskExecution[]
  memories        EmployeeMemory[]
  conversations   WorkforceConversation[]
}

// ==================== TASK EXECUTION ====================
// Every task an AI employee executes is tracked here - NO FAKE DATA

model TaskExecution {
  id              String   @id @default(cuid())
  taskId          String   @unique     // External task ID

  // Task Info
  title           String
  description     String?
  taskType        String               // e.g. "content_creation", "seo_analysis", "lead_qualification"
  complexity      String   @default("standard") // simple, standard, complex, enterprise
  executionPath   String   @default("fast")     // fast, standard, complex, enterprise
  priority        String   @default("medium")

  // Agent Assignment
  // Optional — AI agents (AiAgent table) don't have an Employee row, only the workforce does.
  // Real workforce tasks have assignedEmployeeId set; AI agent runs leave it null.
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id])
  delegatedById     String?
  reviewedById      String?

  // Execution
  status          String   @default("pending") // pending, running, completed, failed, escalated, validated
  input           String   @default("{}")     // JSON: task input/context
  output          String?                   // JSON: task result
  modelUsed       String?                   // Which model was actually used
  modelTier       String?                   // fast, balanced, reasoning, etc.
  promptTokens    Int      @default(0)
  completionTokens Int     @default(0)
  latencyMs       Int      @default(0)
  startedAt       DateTime?
  completedAt     DateTime?

  // Knowledge & Memory Used
  skillsUsed      String   @default("[]") // JSON: skills loaded
  sopsUsed        String   @default("[]") // JSON: SOPs followed
  knowledgeUsed   String   @default("[]") // JSON: knowledge nodes retrieved
  memoryUsed      String   @default("[]") // JSON: memory types accessed
  ragUsed         Boolean  @default(false)

  // Quality
  validationStatus String?  // passed, failed, skipped
  validationScore  Float?
  validatorId      String?
  qualityNotes     String?

  // Self-Healing
  retryCount      Int      @default(0)
  maxRetries      Int      @default(3)
  fallbackModel   String?
  fallbackReason  String?

  // Collaboration
  collaborationType String? // solo, delegated, consulted, parallel, synthesized
  parentTaskId     String?  // For sub-tasks
  childTaskIds     String   @default("[]") // JSON
  consultedEmployees String @default("[]") // JSON

  // Learning
  lessonLearned   String?
  improvementTags String   @default("[]") // JSON

  companyId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== EMPLOYEE MEMORY ====================
// Different memory types for each employee

model EmployeeMemory {
  id              String   @id @default(cuid())
  employeeId      String
  employee        Employee @relation(fields: [employeeId], references: [id])

  memoryType      String               // working, episodic, semantic, procedural, department, organizational
  category        String?              // Sub-category for organization
  title           String
  content         String               // The actual memory content
  metadata        String   @default("{}") // JSON: extra context
  relevance       Float    @default(1.0) // Relevance score 0-1
  accessCount     Int      @default(0)
  lastAccessedAt  DateTime?

  // Source tracking
  sourceType      String?              // execution, lesson, approval, external
  sourceId        String?

  // Governance
  isApproved      Boolean  @default(false)
  approvedById    String?
  expiresAt       DateTime?

  companyId       String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== KNOWLEDGE NODE ====================
// RAG-ready knowledge entries

model KnowledgeNode {
  id              String   @id @default(cuid())
  title           String
  content         String               // The knowledge content
  summary         String?              // Short summary for quick matching
  nodeType        String   @default("document") // document, faq, guideline, template, policy, best_practice
  tags            String   @default("[]") // JSON: searchable tags
  category        String?

  // Embedding for similarity search (stored as JSON array of floats)
  embedding       String?              // JSON: vector embedding

  // Access Control
  departmentId    String?
  department      Department? @relation(fields: [departmentId], references: [id])
  accessLevel     String   @default("company") // public, department, role, restricted
  accessRoles     String   @default("[]") // JSON: roles that can access

  // Usage tracking
  accessCount     Int      @default(0)
  rating          Float    @default(0)    // User-rated quality 0-5

  // Source
  sourceUrl       String?
  sourceType      String?

  companyId       String
  company         Company?  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==================== SOP (Standard Operating Procedure) ====================
// Executable procedures for agents

model Sop {
  id              String   @id @default(cuid())
  name            String
  description     String?
  version         Int      @default(1)
