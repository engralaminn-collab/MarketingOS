// ========================================================================
// TOOL & INTEGRATION SYSTEM — 120+ External Tool Connections
// ========================================================================

// Master catalog of all available tools/integrations
model ToolDefinition {
  id              String   @id @default(cuid())
  toolNumber      Int      @unique           // e.g. 001, 002, ... 120
  name            String                     // e.g. "Google Search Console"
  url             String                     // e.g. "https://search.google.com/search-console"
  authType        String                     // oauth2, api_key, bot_token, partner, none, internal, webhook
  
  // Required environment variables / credentials
  requiredCredentials String @default("[]") // JSON: [{key: "GOOGLE_CLIENT_ID", label: "Client ID", isSecret: false}, ...]
  
  connectionType  String                     // api, rest_api, graph_api, bot_api, webhook, platform, partner_api, internal, tracking, database, redis, automation
  
  // Categorization
  category        String                     // google, meta, social, content, scholarship, university, google_workspace, microsoft, communication, crm, email, ai_provider, payment, tracking, security, notification, infrastructure, devops, bd_platform, alo_internal
  subcategory     String?                    // e.g. "seo", "paid_ads", "organic", "messaging"
  
  capabilities    String                     // e.g. "SEO/keyword/performance data"
  automationLevel String   @default("MANUAL") // AUTO, LIMITED, MANUAL, CHECK, PARTNER, AUTO/LIMITED, MANUAL/AUTO CONTENT
  
  // Status & metadata
  description     String?
  icon            String?                    // Icon name from lucide
  color           String?                    // Brand color hex
  documentationUrl String?
  isEnabled       Boolean  @default(true)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  connections     ToolConnection[]
}

// Actual connections configured per company (stored credentials)
model ToolConnection {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  toolId          String
  tool            ToolDefinition @relation(fields: [toolId], references: [id])
  
  // Connection status
  status          String   @default("disconnected") // disconnected, connecting, active, error, revoked
  connectedAt     DateTime?
  lastSyncedAt    DateTime?
  lastError       String?
  
  // Stored credentials (encrypted at rest in production)
  credentials     String   @default("{}") // JSON: {env_var_name: encrypted_value, ...}
  
  // Configuration
  config          String   @default("{}") // JSON: tool-specific configuration
  webhooks        String   @default("[]") // JSON: registered webhook URLs
  scopes          String   @default("[]") // JSON: OAuth scopes granted
  
  // Usage tracking
  totalCalls      Int      @default(0)
  lastCalledAt    DateTime?
  errorCount      Int      @default(0)
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, toolId])

  usageLogs       ToolUsageLog[]
}

// Tool usage logs for audit and analytics
model ToolUsageLog {
  id              String   @id @default(cuid())
  connectionId    String
  connection      ToolConnection @relation(fields: [connectionId], references: [id])
  
  // Who triggered it
  employeeId      String?                    // AI employee that used the tool
  userId          String?                    // Human user that triggered it
  executionId     String?                    // Related task execution
  
  // What happened
  action          String                     // e.g. "fetch_data", "send_message", "create_post"
  endpoint        String?                    // API endpoint called
  method          String?                    // HTTP method
  requestSummary  String?                    // Summary of request
  responseStatus  Int?                       // HTTP status code
  durationMs      Int?                       // How long the call took
  
  // Result
  isSuccess       Boolean  @default(false)
  errorMessage    String?
  responseData    String?                    // JSON: response data (truncated for large responses)
  
  createdAt       DateTime @default(now())
}


