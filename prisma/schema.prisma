}

// ==================== PHASE 4: AI CALL AGENTS ====================

model OutboundCampaign {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Script
  script          String   @default("")  // conversation flow
  agentId         String?  // voice agent that runs the campaign
  // Contact list
  contactListId   String?  // reference to lead list filter
  // Schedule
  startAt         DateTime?
  endAt           DateTime?
  callingWindowStart String @default("09:00")  // local time
  callingWindowEnd String  @default("18:00")
  callingDays     String   @default("[1,2,3,4,5]")
  timezone        String   @default("Asia/Dhaka")
  // Compliance
  dncSuppression  Boolean  @default(true)
  consentRequired Boolean  @default(true)
  maxAttemptsPerContact Int @default(3)
  retryDelayHours Int      @default(24)
  // Status
  status          String   @default("draft")  // draft | scheduled | running | paused | completed | cancelled
  startedAt       DateTime?
  completedAt     DateTime?
  // Metrics
  totalContacts   Int      @default(0)
  callsAttempted  Int      @default(0)
  callsConnected  Int      @default(0)
  callsAnswered   Int      @default(0)
  // Audit
  createdBy       String?
  creator         User?    @relation("CampaignCreator", fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
  calls           CampaignCall[]
}

model CampaignCall {
  id              String   @id @default(cuid())
  campaignId      String
  campaign        OutboundCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  // Contact
  leadId          String?
  contactId       String?
  toNumber        String
  // Execution
  callId          String?  // FK to Call row when call is made
  attemptNumber   Int      @default(1)
  scheduledAt     DateTime?
  attemptedAt     DateTime?
  connectedAt     DateTime?
  // Outcome
  outcome         String?  // "answered" | "no_answer" | "busy" | "failed" | "dnc_skipped" | "consent_missing"
  durationSec     Int      @default(0)
  // Personalization
  dynamicVariables String  @default("{}")  // JSON: {name, account_id, etc.}
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([campaignId, outcome])
  @@index([toNumber])
}

model CallSummary {
  id              String   @id @default(cuid())
  callId          String   @unique
  call            Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  // Structured summary
  intent          String?
  summary         String
  actionItems     String   @default("[]")  // JSON array
  followUpDate    DateTime?
  followUpType    String?  // "callback" | "email" | "sms" | "meeting"
  // Customer signals
  sentimentScore  Float?   // -1 to 1
  satisfactionScore Float? // 0-100
  objections      String?  // JSON array
  keywords        String?  // JSON array
  // Compliance flags
  complianceFlags String?  // JSON array
  // Audit
  generatedBy     String   @default("ai")  // ai | human
  generatedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  @@index([callId])
}

model KnowledgeBase {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name            String
  description     String?
  // Documents in this KB
  documents       KnowledgeDocument[]
  // Embedding config
  embedProvider   String   @default("local")  // local | gemini
  embedModel      String   @default("bge-m3")
  status          String   @default("active")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
}

model KnowledgeDocument {
  id              String   @id @default(cuid())
  knowledgeBaseId String
  knowledgeBase   KnowledgeBase @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade)
  // Source
  title           String
  sourceType      String   // "pdf" | "docx" | "txt" | "csv" | "url" | "faq"
  sourceUrl       String?  // original URL or storage path
  // Content
  rawText         String   @default("")  // extracted plain text
  chunksCount     Int      @default(0)
  // Permissions
  visibleToAgents String   @default("[]")  // JSON array of agentIds; empty = all
  // Status
  status          String   @default("processing")  // processing | indexed | failed | archived
  indexedAt       DateTime?
  // Audit
  uploadedBy      String?
  creator         User?    @relation("KnowledgeDocCreator", fields: [uploadedBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([knowledgeBaseId, status])
  chunks          KnowledgeChunk[]
}

model KnowledgeChunk {
  id              String   @id @default(cuid())
  documentId      String
  document        KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  // Chunk content
  chunkIndex      Int
  text            String
  // Embedding (stored as base64 or vector reference)
  embedding       String?  // base64-encoded Float32Array; null until indexed
  // Source reference (for citations)
  sourceLocation  String?  // e.g. "page 5, paragraph 2"
  // Retrieval audit
  retrievalCount  Int      @default(0)
  lastRetrievedAt DateTime?
  createdAt       DateTime @default(now())

  @@index([documentId, chunkIndex])
}

// ==================== PHASE 5: HUMAN CONTACT CENTER + CRM ====================

model AgentStatus {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation("AgentStatusUser", fields: [userId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // State
  status          String   @default("offline")  // offline | available | busy | after_call | break | lunch | training
  statusChangedAt DateTime @default(now())
  // Current call (if any)
  currentCallId   String?
  // Metrics (rolling)
  callsToday      Int      @default(0)
  avgHandleTimeSec Int     @default(0)
  // Optional: scheduled break end
  breakEndsAt     DateTime?
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
}

model SupervisorAction {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Action
  actionType      String   // "listen" | "whisper" | "barge_in" | "take_over" | "force_transfer" | "force_release"
  callId          String?
  agentUserId     String?  // human agent being supervised
  supervisorUserId String  // supervisor performing the action
  supervisor      User     @relation("SupervisorActor", fields: [supervisorUserId], references: [id])
  // Context
  reason          String?
  metadata        String   @default("{}")  // JSON
  // Result
  outcome         String?  // "success" | "failed" | "rejected"
  errorMessage    String?
  timestamp       DateTime @default(now())

  @@index([companyId, timestamp])
  @@index([agentUserId])
}

model Customer {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Identity
  name            String
  email           String?
  phone           String?
  alternatePhone  String?
  // Profile
  customerCompany String?  // customer's company name (renamed to avoid clash with relation)
  jobTitle        String?
  country         String?
  city            String?
  // Status
  status          String   @default("lead")  // lead | qualified | customer | churned | blocked
  tags           String   @default("[]")  // JSON array
  // Assignments
  assignedAgentId String?
  // Consent preferences
  consentMarketingSms Boolean @default(false)
  consentMarketingEmail Boolean @default(false)
  consentCallRecording Boolean @default(false)
  // Links
  leadId          String?  // back-reference to Lead if originated as a lead
  // Audit
  createdBy       String?
  creator         User?    @relation("CustomerCreator", fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
  @@index([companyId, phone])
  @@index([companyId, email])
}

model SharedInboxMessage {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Channel
  channel         String   // "voice" | "sms" | "email" | "web_chat" | "whatsapp_disabled"
  // Direction
  direction       String   // "inbound" | "outbound"
  // Parties
  fromAddress     String
  toAddress       String
  fromName        String?
  toName          String?
  // Content
  subject         String?
  body            String
  mediaUrls       String   @default("[]")  // JSON array
  // Threading
  threadId        String?
  // Assignment
  assignedToId    String?  // user id
  // Status
  status          String   @default("unread")  // unread | read | pending_reply | resolved | escalated
  isAiGenerated   Boolean  @default(false)  // per directive §14: distinguish AI vs provider-confirmed
  isProviderConfirmed Boolean @default(false)  // set true when SMS/email delivery receipt arrives
  // Tags + internal notes
  tags            String   @default("[]")  // JSON array
  internalNotes   String?  // for internal context (not sent to customer)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, channel, status])
  @@index([companyId, assignedToId])
  @@index([threadId])
}

model CallAnalytics {
  id              String   @id @default(cuid())
  callId          String   @unique
  call            Call     @relation(fields: [callId], references: [id], onDelete: Cascade)
  // Sentiment
  overallSentiment String? // "positive" | "neutral" | "negative" | "mixed"
  sentimentScore   Float?  // -1 to 1
  sentimentTimeline String? // JSON array of { timestampSec, score }
  // Topics
  topics          String?  // JSON array of { topic, confidence, mentions }
  // Quality
  talkToListenRatio Float?  // 0-2 (1 = balanced)
  silencePct       Float?  // 0-100
  interruptionCount Int?
  // Agent performance (if human-handled)
  agentScorecard  String?  // JSON: { greeting, empathy, accuracy, closing } each 0-5
  // Compliance
  complianceFlags  String?  // JSON array: ["disclosure_missing", "dnc_violation_attempt"]
  // Generated by
  generatedBy     String   @default("ai")  // ai | human
  generatedAt     DateTime @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?

  @@index([callId])
}

// ==================== PHASE 6: BILLING + SAAS ====================

model SubscriptionPlan {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String
  description     String?
  // Pricing (USD/month)
  priceMonthly    Float    @default(0)
  priceYearly     Float    @default(0)
  // Limits
  maxPhoneNumbers Int      @default(1)
  maxUsers        Int      @default(3)
  maxAiMinutes    Int      @default(100)
  maxTtsCharacters Int     @default(10000)
  maxAsrSeconds   Int      @default(3600)
  maxRecordingStorageMb Int @default(500)
  maxOutboundCallsPerDay Int @default(50)
  // Features (JSON array of feature flags)
  features        String   @default("[]")
  // Trial
  trialDays       Int      @default(0)
  // Status
  isPublic        Boolean  @default(true)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  subscriptions   TenantSubscription[]
}

model TenantSubscription {
  id              String   @id @default(cuid())
  companyId       String   @unique
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  planId          String
  plan            SubscriptionPlan @relation(fields: [planId], references: [id])
  // Billing cycle
  billingCycle   String   @default("monthly")  // monthly | yearly
  startsAt       DateTime @default(now())
  endsAt         DateTime?
  // Trial
  isTrial        Boolean  @default(false)
  trialEndsAt    DateTime?
  // Status
  status         String   @default("active")  // active | past_due | cancelled | suspended
  cancelledAt    DateTime?
  // Payment method reference (provider-specific)
  paymentMethodRef String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model UsageCredit {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Credit type
  creditType      String   // "ai_minutes" | "tts_chars" | "asr_seconds" | "recording_mb" | "outbound_calls"
  // Balance
  balance         Float    @default(0)
  // Auto-recharge
  autoRechargeThreshold Float @default(0)
  autoRechargeAmount Float @default(0)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, creditType])
}

model Invoice {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Invoice number (human-readable)
  invoiceNumber   String   @unique
  // Period
  periodStart     DateTime
  periodEnd       DateTime
  // Amounts (USD)
  subtotal        Float
  tax             Float    @default(0)
  total           Float
  // Currency
  currency        String   @default("USD")
  // Line items (JSON array of { description, quantity, unitPrice, total })
  lineItems       String
  // Status
  status          String   @default("draft")  // draft | sent | paid | past_due | void | refunded
  sentAt          DateTime?
  paidAt          DateTime?
  dueAt           DateTime?
  // Payment
  paymentMethodRef String?
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
  payments        Payment[]
}

model Payment {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // Amount
  amount          Float
  currency        String   @default("USD")
  // Provider
  provider        String   // "stripe" | "sslcommerz" | "manual" | "bank_transfer"
  providerPaymentId String?
  // Method
  method          String   // "card" | "bank" | "wallet" | "manual"
  // Status
  status          String   @default("pending")  // pending | succeeded | failed | refunded | disputed
  processedAt     DateTime?
  failureReason   String?
  // Audit
  createdBy       String?
  creator         User?    @relation("PaymentCreator", fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
}

model BillingAdjustment {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Type
  type            String   // "credit" | "charge" | "refund" | "waiver"
  // Amount (positive number; sign determined by type)
  amount          Float
  currency        String   @default("USD")
  // Reason
  reason          String
  // Reference (optional)
  invoiceId       String?
  // Audit (per directive §5: manual adjustments with audit logs)
  createdBy       String
  creator         User     @relation("BillingAdjustmentCreator", fields: [createdBy], references: [id])
  approvedBy      String?
  approver        User?    @relation("BillingAdjustmentApprover", fields: [approvedBy], references: [id])
  createdAt       DateTime @default(now())

  @@index([companyId, createdAt])
}

// ==================== EXPENSES (missing model — causes 11 TS errors) ========
model Expense {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  title       String
  description String?
  amount      Float
  currency    String   @default("BDT")
  category    String   @default("general")
  date        DateTime @default(now())
  status      String   @default("pending") // pending | approved | rejected | paid
  createdBy   String?
  creator     User?    @relation("ExpenseCreator", fields: [createdBy], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId, date])
  @@index([companyId, status])
}

// ==================== SKILLS + PROMPTS + AGENT PROFILES ====================
// Comprehensive skill registry + prompt library + AI Agent profiles (2,000)

model Skill {
  id              String   @id @default(cuid())
  name            String   @unique
  displayName     String
  category        String   // marketing, sales, engineering, finance, operations, support, creative, data, security, management
  subcategory     String?
  description     String
  proficiencyLevels String  @default("[\"beginner\",\"intermediate\",\"advanced\",\"expert\"]")
  prerequisites   String   @default("[]")  // JSON: skill IDs required before this
  tools           String   @default("[]")  // JSON: tool names this skill uses
  isActive        Boolean  @default(true)
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, isActive])
}

model Prompt {
  id              String   @id @default(cuid())
  name            String
  category        String   // system, task, role, instruction, template
  subcategory     String?
  content         String   // The prompt text (with {{variables}})
  variables       String   @default("[]")  // JSON: list of template variables
  language        String   @default("en")
  tags            String   @default("[]")  // JSON
  companyId       String?
  company         Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  departmentId    String?
  department      Department? @relation("PromptDepartment", fields: [departmentId], references: [id])
  applicableRoles String   @default("[]")  // JSON: employee levels
  version         Int      @default(1)
  isActive        Boolean  @default(true)
  useCount       Int      @default(0)
  rating          Float    @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([category, isActive])
  @@index([departmentId])
}

model AgentProfile {
  id              String   @id @default(cuid())
  agentId         String   @unique  // Links to Employee.employeeId (EMP-XXXX)
  name            String
  role            String   // Chief Marketing Officer, SEO Specialist, etc.
  department      String
  level           String   // executive, director, manager, supervisor, specialist, worker

  // Capabilities
  skillsJson     String   @default("[]")  // JSON: array of skill names
  toolsJson      String   @default("[]")  // JSON: array of tool names
  promptsJson    String   @default("[]")  // JSON: array of prompt IDs
  sopsJson       String   @default("[]")  // JSON: array of SOP IDs

  // Model config
  modelTier      String   @default("balanced")
  preferredModel String?

  // Knowledge + Memory
  knowledgeBaseIds String  @default("[]")  // JSON: knowledge node IDs
  memoryType     String   @default("episodic")  // episodic, semantic, procedural, working

  // Behavior
  constitution   String   @default("")  // Behavioral rules
  authority      String   @default("{}")  // JSON: what they can authorize
  kpisJson       String   @default("[]")  // JSON: KPI definitions
  collaborationRules String  @default("[]")  // JSON: who they can collaborate with
  escalationRules String  @default("[]")  // JSON: when to escalate

  // Status
  isActive       Boolean  @default(true)
  totalExecutions Int     @default(0)
  successRate   Float     @default(100)
  avgLatencyMs  Int       @default(0)

  companyId      String
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([companyId, isActive])
  @@index([companyId, department])
}

// ==================== SUPPRESSION LIST (DNC) ====================
model SuppressionList {
  id              String   @id @default(cuid())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phoneNumber     String
  reason          String   @default("user_request")  // user_request | complaint | dnc_registry | admin_block
  source          String   @default("web_form")  // web_form | sms_reply | ivr | admin | api
  blockedAt       DateTime @default(now())
  expiresAt      DateTime?
  createdBy       String?
  createdAt       DateTime @default(now())

  @@unique([companyId, phoneNumber])
  @@index([companyId, phoneNumber])
}

// ==================== INTEGRATION SCOPES + HEALTH CHECKS ====================
model IntegrationScope {
  id              String   @id @default(cuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  scope           String
  isGranted       Boolean  @default(false)
  grantedAt       DateTime?
  createdAt       DateTime @default(now())

  @@unique([integrationId, scope])
  @@index([integrationId])
}

model IntegrationHealthCheck {
  id              String   @id @default(cuid())
  integrationId   String
  integration     Integration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  checkedAt       DateTime @default(now())
  status          String   // connected | expired | revoked | unavailable | error
  tokenValid      Boolean  @default(false)
  refreshTokenValid Boolean @default(false)
  scopesValid     Boolean  @default(false)
  resourcesAccessible Boolean @default(false)
  errorMessage     String?
  latencyMs       Int?
  createdAt       DateTime @default(now())

  @@index([integrationId, checkedAt])
}


model PasswordReset {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation("PasswordResetUser", fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())

  @@index([token, expiresAt])
}

// ==========================================================================
// UNIVERSAL AI LEAD DISCOVERY, CUSTOMER ACQUISITION & ORGANIC GROWTH ENGINE
// Schema extensions — Requirements 1-16 (industry-agnostic, country-agnostic,
// multi-tenant, free-first, AI-powered). All models are tenant-isolated via
// companyId unless explicitly global (catalog/reference data).
// ==========================================================================

// ── Requirement 2: Dynamic industry taxonomy (not hardcoded) ──────────────
model Industry {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  parentId    String?  // Self-reference for sub-industries
  parent      Industry? @relation("IndustryHierarchy", fields: [parentId], references: [id])
  children    Industry[] @relation("IndustryHierarchy")
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  isCustom    Boolean  @default(false) // true when added by an admin (not from the default catalog)
  companyId   String?  // null = global catalog; non-null = tenant-custom industry
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([parentId])
  @@index([companyId])
}

// ── Requirement 2: Geographic / country reference data ────────────────────
model Country {
  id          String   @id @default(cuid())
  isoCode     String   @unique // ISO 3166-1 alpha-2 (e.g. "US", "BD", "GB")
  name        String
  slug        String   @unique
  region      String?  // e.g. "North America", "South Asia"
  subRegion   String?  // e.g. "Northern America", "Central Asia"
  flagEmoji   String?
  currencyCode String? // ISO 4217 (e.g. "USD", "BDT")
  currencySymbol String?
  defaultLanguage String?
  privacyLawNote String? // e.g. "GDPR applies", "CCPA applies" — guidance only, not legal advice
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  regions     Region[]
}

model Region {
  id          String   @id @default(cuid())
  countryId   String
  country     Country  @relation(fields: [countryId], references: [id])
  code        String?  // ISO 3166-2 (e.g. "US-CA", "BD-DH")
  name        String   // e.g. "California", "Dhaka Division"
  type        String?  // state|province|division|prefecture|county
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@unique([countryId, code])
  @@index([countryId])
}

// ── Requirement 4: Free-first data discovery provider registry ────────────
model DataProvider {
  id                   String   @id @default(cuid())
  slug                 String   @unique // e.g. "google_trends", "openstreetmap", "product_hunt"
  name                 String
  category             String   // google|public_market|social_community|government|trade_association|open_data
  officialUrl          String
  accessMethod         String   // official_api|open_data|permitted_scrape|oauth|manual
  availableDataFields  String   // JSON array of field names this provider can return
  authRequirements     String?  // none|api_key|oauth|registration
  freeTierLimit        String?  // e.g. "1000 req/day", "unlimited"
  paidTierRequirements String?
  rateLimit            String?  // e.g. "10 req/sec"
  licensingAndReuse    String?  // License terms (e.g. "CC BY 4.0", "ODbL", "ToS section 3.2")
  geographicCoverage   String?  // global|regional list
  lastVerifiedAt       DateTime?
  verificationStatus   String   @default("unverified") // unverified|verified|degraded|broken
  sourceReliability    Int      @default(50) // 0-100 — assessed reliability score
  integrationStatus    String   @default("not_integrated") // not_integrated|in_progress|integrated|paused
  isActive             Boolean  @default(true)
  companyId            String?  // null = global catalog; non-null = tenant-registered provider
  company              Company? @relation(fields: [companyId], references: [id])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  discoveredLeads      DiscoveredLead[]
  costEvents           CostEvent[]
}

// ── Requirement 3: Two operating modes (Universal Discovery + Targeted) ───
model DiscoveryCampaign {
  id                String   @id @default(cuid())
  name              String
  mode              String   @default("targeted") // universal|targeted
  // Targeting profile (Mode B)
  industryId        String?
  subIndustryIds    String?  // JSON array of Industry ids
  countryIds        String?  // JSON array of Country ids
  regionIds         String?  // JSON array of Region ids
  businessType      String?  // b2b|b2c|b2b2c|non_profit|government
  audienceProfile   String?  // Free-text target audience description
  productOrService  String?
  buyerIntentSignals String? // JSON array of signal types to look for
  keywords          String?  // JSON array of keywords/topics
  competitorRefs    String?  // JSON array of competitor names/URLs
  campaignObjective String?  // lead_generation|market_research|brand_awareness|audience_growth
  sourceSelection   String?  // JSON array of DataProvider slugs to use
  budgetPreference  String   @default("free_first") // free_only|free_first|paid_with_approval
  qualificationCriteria String? // JSON — min score, required signals
  exclusionCriteria String?  // JSON — industries/regions/keywords to exclude
  autonomyLevel     String   @default("approval_required") // suggest_only|approval_required|approved_automation
  status            String   @default("draft") // draft|active|paused|completed|archived
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  discoveredLeads   DiscoveredLead[]
  marketOpportunities MarketOpportunity[]
  approvalRequests  ApprovalRequest[]

  @@index([companyId, status])
  @@index([mode])
}

// ── Requirement 6: Public lead discovery with full provenance ────────────
model DiscoveredLead {
  id                    String   @id @default(cuid())
  businessName          String
  officialWebsite       String?
  publicBusinessCategory String?
  businessLocation      String?  // City, State, Country (free-text from source)
  countryId             String?
  publicContactChannel  String?  // Public contact channel where permitted (e.g. "info@", contact form URL)
  publiclyStatedProducts String? // JSON array
  publicBusinessProfile String?  // Free-text profile from source
  // ── Mandatory provenance fields (Requirement 6) ──
  sourceUrl             String   // Where the lead was found
  sourceProviderId      String?
  sourceProvider        DataProvider? @relation(fields: [sourceProviderId], references: [id])
  discoveryTimestamp    DateTime @default(now())
  applicableUsageRestrictions String? // License/reuse restrictions
  confidenceLevel       String   @default("medium") // low|medium|high
  dataFreshness         String   @default("fresh") // fresh|recent|stale|expired
  reviewStatus          String   @default("pending") // pending|reviewed|approved|rejected
  evidenceOfRelevance   String?  // JSON array of evidence snippets supporting relevance
  dedupHash             String?  @unique // Normalized hash for auto-deduplication
  leadId                String?  // Links to CRM Lead once promoted
  campaignId            String?
  campaign              DiscoveryCampaign? @relation(fields: [campaignId], references: [id])
  companyId             String
  company               Company  @relation(fields: [companyId], references: [id])
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  intentSignals         BuyerIntentSignal[]

  @@index([companyId, reviewStatus])
  @@index([campaignId])
  @@index([sourceProviderId])
}

// ── Requirement 7: AI buyer intent signals (evidence-based) ──────────────
model BuyerIntentSignal {
  id                String   @id @default(cuid())
  discoveredLeadId  String?
  discoveredLead    DiscoveredLead? @relation(fields: [discoveredLeadId], references: [id])
  leadId            String?
  lead              Lead?    @relation(fields: [leadId], references: [id])
  signalType        String   // public_request|rfq|procurement_opportunity|business_expansion|announced_project|service_requirement|repeated_interest|website_enquiry
  evidenceUrl       String?
  evidenceText      String   // The actual evidence snippet (never invented)
  signalStrength    Int      @default(50) // 0-100 — AI-assessed strength based on evidence clarity
  detectedAt        DateTime @default(now())
  detectedBy        String   @default("ai_engine") // ai_engine|manual
  companyId         String
  createdAt         DateTime @default(now())

  @@index([discoveredLeadId])
  @@index([leadId])
  @@index([companyId, signalType])
}

// ── Requirement 7: Explainable lead score breakdown ──────────────────────
model LeadScoreBreakdown {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  dimension   String   // industry_relevance|geographic_match|product_service_match|buying_intent|business_suitability|data_freshness|source_reliability
  score       Int      // 0-100
  maxScore    Int      @default(100)
  evidence    String?  // Explanation of why this score was assigned
  computedAt  DateTime @default(now())

  @@index([leadId])
}

// ── Requirement 12: Generic approval engine (Suggest/Approve/Automate) ───
model ApprovalRequest {
  id              String   @id @default(cuid())
  requestType     String   // paid_subscription|ad_spend|public_publishing|bulk_export|outbound_campaign|contact_lead|credential_change|integration_change
  requesterId     String?
  resourceType    String?  // lead|campaign|content|integration|expense
  resourceId      String?
  payload         String   // JSON — the proposed action details
  autonomyLevel   String   @default("approval_required") // suggest_only|approval_required|approved_automation
  status          String   @default("pending") // pending|approved|rejected|expired|auto_executed
  approverId      String?
  approverNote    String?
  approvedAt      DateTime?
  expiresAt       DateTime?
  leadId          String?
  lead            Lead?    @relation(fields: [leadId], references: [id])
  campaignId      String?
  campaign        DiscoveryCampaign? @relation(fields: [campaignId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, status])
  @@index([requestType, status])
}

// ── Requirement 13: Cost intelligence (free-first, USD) ──────────────────
model CostEvent {
  id                String   @id @default(cuid())
  provider          String   // e.g. "google_trends", "openai", "z_ai"
  operation         String   // e.g. "api_call", "tts_synthesis", "lead_discovery"
  estimatedCostUsd  Float    @default(0)
  actualCostUsd     Float    @default(0)
  freeTierUsed      Boolean  @default(true)
  budgetPreference  String   @default("free_first") // free_only|free_first|paid_with_approval
  approvalRequired  Boolean  @default(false)
  approvalRequestId String?
  quotaBefore       Int?     // Remaining quota before this operation
  quotaAfter        Int?     // Remaining quota after
  warningTriggered  Boolean  @default(false) // true if quota exhaustion warning fired
  dataProviderId    String?
  dataProvider      DataProvider? @relation(fields: [dataProviderId], references: [id])
  timestamp         DateTime @default(now())
  companyId         String
  company           Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, timestamp])
  @@index([provider, timestamp])
}

// ── Requirement 9: Real website growth / SEO audit ───────────────────────
model WebsiteAudit {
  id              String   @id @default(cuid())
  url             String
  auditType       String   @default("full") // full|technical_seo|content|performance|structured_data
  overallScore    Int      @default(0) // 0-100
  issues          String   // JSON array of {severity, category, title, detail, recommendation}
  recommendations String   // JSON array of prioritized recommendations
  pageSpeedScore  Int?
  contentGaps     String?  // JSON array of identified content gaps
  landingPageSuggestions String? // JSON
  conversionOptSuggestions String? // JSON
  structuredDataIssues String? // JSON
  internalLinkSuggestions String? // JSON
  leadFormOptSuggestions String? // JSON
  auditedAt       DateTime @default(now())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, auditedAt])
  @@index([url])
}

// ── Requirement 10: Social media audience growth analytics ───────────────
model SocialAudienceMetric {
  id              String   @id @default(cuid())
  socialAccountId String   // Links to SocialAccount.id
  platform        String   // meta|linkedin|x|tiktok|youtube|pinterest|instagram
  followersCount  Int      @default(0)
  followingCount  Int?
  postsCount      Int?
  engagementRate  Float?   // Percentage (likes+comments+shares)/followers
  avgLikesPerPost Float?
  avgCommentsPerPost Float?
  growthDelta     Int      @default(0) // Net follower change since last snapshot
  topHashtags     String?  // JSON array
  bestPostingTime String?  // ISO day/hour recommendation
  recordedAt      DateTime @default(now())
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])

  @@index([companyId, recordedAt])
  @@index([socialAccountId, recordedAt])
}

model ContentCalendarItem {
  id              String   @id @default(cuid())
  platform        String   // meta|linkedin|x|tiktok|youtube|pinterest|blog|email
  scheduledAt     DateTime
  contentId       String?  // Links to Content.id if drafted
  title           String
  status          String   @default("draft") // draft|scheduled|published|failed|cancelled
  aiGenerated     Boolean  @default(false)
  hashtags        String?  // JSON array
  approvalRequired Boolean @default(true)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([companyId, scheduledAt])
  @@index([platform, status])
}

// ── Requirement 14: Data retention / deletion policies ───────────────────
model DataRetentionPolicy {
  id              String   @id @default(cuid())
  dataType        String   // lead|discovered_lead|call_recording|transcript|audit_log|consent_record
  retentionDays   Int      @default(365) // 0 = retain indefinitely
  deletionAction  String   @default("auto_delete") // auto_delete|anonymize|archive
  isActive        Boolean  @default(true)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([companyId, dataType])
}

// ── Requirement 3 Mode A: Universal discovery — market opportunities ─────
model MarketOpportunity {
  id              String   @id @default(cuid())
  title           String
  description     String
  opportunityType String   // emerging_demand|new_segment|geographic_expansion|product_gap|trend_surge
  industryId      String?
  countryIds      String?  // JSON array of Country ids
  evidence        String   // JSON array of evidence snippets (source URL + text)
  confidenceLevel String   @default("medium") // low|medium|high
  estimatedSize   String?  // Free-text market size estimate
  recommendedAction String? // AI-suggested next step
  campaignId      String?
  campaign        DiscoveryCampaign? @relation(fields: [campaignId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  detectedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  @@index([companyId, opportunityType])
  @@index([campaignId])
}
